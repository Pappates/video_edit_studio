# .env.example dosyasını .env olarak kopyalayıp doldurun.

# --- Claude (doğrulama, muhabbet tespiti, reels için görüntü analizi) ---
# CLAUDE_BACKEND:
#   auto -> API anahtarı varsa API, yoksa Claude Code (aboneliğin), o da yoksa kapalı
#   cli  -> her zaman Claude Code / aboneliğin (Pro/Max limitlerinden düşer, API ücreti yok)
#   api  -> her zaman Claude API (ANTHROPIC_API_KEY gerekir, kullanım başına ücretli)
#   off  -> Claude kullanma (yalnızca kurallar + sezgisel reels bölme)
CLAUDE_BACKEND=auto

# Abonelik (Claude Code) ayarları
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=900

# API ayarları (yalnızca CLAUDE_BACKEND=api veya auto + anahtar varsa)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=8000

# --- Whisper ---
# GPU yoksa medium veya small daha hızlıdır; large-v3 en doğru Türkçe sonucu verir.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
LANGUAGE=tr

# --- Konuşmacı ayrımı ---
# auto: pyannote kurulu ve HF_TOKEN varsa pyannote, yoksa hafif model (ek kurulum gerektirmez)
# light: hafif model (WeSpeaker, ~26 MB, ilk kullanımda indirilir) | pyannote | off
DIARIZATION_BACKEND=auto
# Otomatik kişi sayısında iki grubun aynı kişi sayılacağı benzerlik eşiği.
# Farklı kişiler tek kişi görünüyorsa yükseltin (0.55), tek kişi ikiye bölünüyorsa düşürün (0.35).
SPEAKER_SIMILARITY=0.45
# pyannote için (isteğe bağlı, en yüksek doğruluk): pip install pyannote.audio
HF_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# --- Kesim hassasiyeti ---
REPEAT_SIMILARITY=0.72
REPEAT_WINDOW_SEC=120
SILENCE_MIN_SEC=1.2
SILENCE_KEEP_SEC=0.35
CUT_PAD_BEFORE=0.08
CUT_PAD_AFTER=0.08

# --- Render ---
VIDEO_CRF=18
VIDEO_PRESET=veryfast

DATA_DIR=data
